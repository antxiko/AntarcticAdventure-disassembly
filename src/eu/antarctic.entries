0x7711   # destino de tabla de saltos
0x7729   # destino de tabla de saltos
0x773F   # destino de tabla de saltos

# --- ANADIDO A MANO. Ojo: volver a lanzar arranca_version.py pisa este fichero.

# El segundo despachador, el de 0x49AF, que es de otra clase: un JP (HL) pelado
# con HL = 0x49B0 + A. O sea que A no indexa una tabla de DIRECCIONES sino
# CODIGO incrustado, con paso de cuatro bytes. Los cuatro casos cargan un valor
# distinto en A y caen todos en el mismo call 48D4h.
0x49B0   # caso 0: ld a,0E0h
0x49B4   # caso 1: ld a,001h
0x49B8   # caso 2: ld a,020h
0x49BC   # caso 3: ld a,0FFh

# --- CODIGO AL QUE NO LLEGA NADIE. Son rutinas de verdad, no datos: el
# trazador no las alcanza porque ninguna instruccion las llama.
0x48BE   # lee un byte de la VRAM: call 48C7h / in a,(098h) / ei / ret
0x4404   # trozo suelto: call 458Eh / ld a,(0E002h) / rlca ... (nadie lo llama)
0x4448   # un RET suelto
0x4177   # ld hl,0E004h / dec (hl) / ret nz / jp 43ECh, sin quien lo llame
